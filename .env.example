NODE_ENV=production
PORT=8081
HOST=0.0.0.0
LOG_LEVEL=info

# MCP server metadata
MCP_SERVER_NAME=mcp-inspector-server
MCP_SERVER_VERSION=0.1.0
MCP_TRANSPORT=streamable-http

# Optional auth for this MCP server. Leave empty in local-only development.
MCP_AUTH_TOKEN=change-me

# Comma-separated target MCP endpoints that this inspector may connect to.
# Use exact URLs. This prevents SSRF and accidental access to arbitrary hosts.
INSPECTOR_ALLOWED_TARGETS=http://mcp-postgre-server:8080/mcp,http://mcp-milvus-server:8080/mcp

# Timeouts and limits
INSPECTOR_TIMEOUT_MS=10000
INSPECTOR_MAX_TOOL_RESULT_BYTES=262144
INSPECTOR_MAX_LOG_EVENTS=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
